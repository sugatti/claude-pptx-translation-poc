# Claude Platform on AWS 接続に必須（デフォルト値なし）
AWS_REGION=ap-northeast-1
ANTHROPIC_AWS_WORKSPACE_ID=

# 認証方式はどちらか一方でよい
# (A) 短期APIキーを発行済みの場合はこちらを設定（最大12時間で失効）
ANTHROPIC_API_KEY=

# (B) ANTHROPIC_API_KEY を設定しない場合、標準のAWS認証情報チェーン
#     （環境変数 / 共有プロファイル / IAMロール等）でSigV4署名される。
#     可能なら .env に書かず、シェル側で `export AWS_PROFILE=<プロファイル名>`
#     （aws sso login 済みのプロファイル等）を使う方が安全。
#     一時クレデンシャルを直接貼る場合のみ以下3つを設定（長期アクセスキーのみなら
#     AWS_SESSION_TOKEN は不要。SSO/AssumeRoleの一時クレデンシャルには必須）。
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
